Cell[TextData[{
 "Calculating the frame-shifted transport coefficient, by noting that\n ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["\[CapitalOmega]", "q"], "T"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[CapitalOmega]", "J"], 
      SuperscriptBox[
       RowBox[{"T", "(", 
        FractionBox["n", 
         RowBox[{"\[CurlyEpsilon]", " ", "+", " ", "P"}]], ")"}], "2"]}], "+", 
     FractionBox["1", 
      RowBox[{"\[CurlyEpsilon]", " ", "+", " ", "P"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c30e3858-bfd9-b847-acf7-38b0a19d8938"],
 "\n in the Eckart frame. We find that"
}], "Text",
 CellChangeTimes->{{3.949691541917368*^9, 
  3.9496916816760178`*^9}},ExpressionUUID->"11e14ba1-d451-3945-8754-\
2886189b0f8e"],

