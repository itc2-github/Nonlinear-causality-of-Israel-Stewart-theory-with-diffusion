      RowBox[{
       RowBox[{"-", "2"}], "+", 
       RowBox[{"3", " ", 
        SuperscriptBox["qbar", "2"]}]}], ")"}], " ", 
     "\[Lambda]0"}]}]]}]], "Output",
 CellChangeTimes->{{3.950027725781254*^9, 3.950027777423435*^9}, 
