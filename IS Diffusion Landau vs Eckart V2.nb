Cell[TextData[{
 "Below we generate a quartic polynomial to read off conditions that the \
roots such that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["P", "4"], "(", 
     SuperscriptBox["x", "*"], ")"}], "=", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "75c4c3a3-edd5-5b41-9e2d-2502c00910cf"],
 " are bounded between -1 and +1:"
}], "Text",
 CellChangeTimes->{{3.9501020961938496`*^9, 
  3.9501021544009857`*^9}},ExpressionUUID->"c8b7ad57-7f33-1945-affe-\
24324e9d3df1"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"P4", "[", "x_", "]"}], ":=", 
   RowBox[{
    SuperscriptBox["x", "4"], "+", 
    RowBox[{"A3", " ", 
     SuperscriptBox["x", "3"]}], "+", 
    RowBox[{"A2", " ", 
     SuperscriptBox["x", "2"]}], "+", 
    RowBox[{"A1", " ", "x"}], "+", "A0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Collect", "[", 
  RowBox[{
   RowBox[{"P4", "[", 
    RowBox[{"1", "-", "z0"}], "]"}], ",", "z0", ",", "FullSimplify"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Collect", "[", 
  RowBox[{
   RowBox[{"P4", "[", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "z0"}], "]"}], ",", "z0", ",", "FullSimplify"}],
   "]"}]}], "Input",
 CellChangeTimes->{{3.950101144026516*^9, 3.9501012043285046`*^9}},
 CellLabel->
  "In[232]:=",ExpressionUUID->"09d207e8-1892-ee4f-bedd-f6e1d148d03f"],

Cell[BoxData[
 RowBox[{"1", "+", "A0", "+", "A1", "+", "A2", "+", "A3", "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "4"}], "-", "A1", "-", 
     RowBox[{"2", " ", "A2"}], "-", 
     RowBox[{"3", " ", "A3"}]}], ")"}], " ", "z0"}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"6", "+", "A2", "+", 
     RowBox[{"3", " ", "A3"}]}], ")"}], " ", 
   SuperscriptBox["z0", "2"]}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "4"}], "-", "A3"}], ")"}], " ", 
   SuperscriptBox["z0", "3"]}], "+", 
  SuperscriptBox["z0", "4"]}]], "Output",
 CellChangeTimes->{{3.950101171518774*^9, 3.950101204774788*^9}},
 CellLabel->
  "Out[233]=",ExpressionUUID->"4ac1df70-fe22-6f4e-af66-2f6e33a59f68"],

Cell[BoxData[
 RowBox[{"1", "+", "A0", "-", "A1", "+", "A2", "-", "A3", "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "4"}], "+", "A1", "-", 
     RowBox[{"2", " ", "A2"}], "+", 
     RowBox[{"3", " ", "A3"}]}], ")"}], " ", "z0"}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{"6", "+", "A2", "-", 
     RowBox[{"3", " ", "A3"}]}], ")"}], " ", 
   SuperscriptBox["z0", "2"]}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "4"}], "+", "A3"}], ")"}], " ", 
