     FractionBox[
      RowBox[{"5", "\[Lambda]"}], 
      RowBox[{"4", 
       RowBox[{"(", 
        RowBox[{"\[CurlyEpsilon]", "/", "3"}], ")"}]}]], "+", " ", 
     FractionBox["3", 
      RowBox[{"4", "\[CurlyEpsilon]"}]]}], ")"}], 
   RowBox[{"(", 
    FractionBox["n", 
     RowBox[{"\[CurlyEpsilon]", "/", "3"}]], ")"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9496895676103725`*^9, 3.9496895960864887`*^9}, {
