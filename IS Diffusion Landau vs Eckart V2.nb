   3.894641136072174*^9, 3.8946412353075113`*^9}, {3.935422972542944*^9, 
   3.935423037395014*^9}, 3.935423414031*^9, {3.9354246235917816`*^9, 
   3.935424626516388*^9}, {3.9356907673072376`*^9, 3.9356908234252396`*^9}, {
   3.935691266468996*^9, 3.935691268924532*^9}, {3.935693358738323*^9, 
