Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"0 \[LessEqual] 1 + \\!\\(\\*SubscriptBox[\\(A\\), \\(0\\)]\\) \
+ \\!\\(\\*SubscriptBox[\\(A\\), \\(1\\)]\\): 0 \[LessEqual] \"\>", "\[InvisibleSpace]", 
   FractionBox[
    RowBox[{
     RowBox[{
      RowBox[{"(", 
