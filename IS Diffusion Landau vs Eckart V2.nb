          "\[CapitalOmega]n"}]}], ")"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"P", "+", "\[CurlyEpsilon]"}], ")"}], " ", 
       "\[CapitalOmega]"}]], "]"}]}], 
   "\[InvisibleSpace]", "\<\" \[LessEqual] 1\"\>"}],
  SequenceForm[
  "|B|/4 \[LessEqual] 1: ", Rational[1, 8] 
   Abs[$CellContext`J ($CellContext`P + $CellContext`\[CurlyEpsilon])^(-1) \
$CellContext`\[Psi] $CellContext`\[CapitalOmega]^(-1) (
