Cell[CellGroupData[{

Cell["Landau Principle Part", "Chapter",
 CellChangeTimes->{{3.8946415289653344`*^9, 3.8946415351670837`*^9}, {
  3.9354263025796967`*^9, 
  3.9354263037380543`*^9}},ExpressionUUID->"37a035f8-bdad-41aa-82b6-\
9c1e6a61a2d8"],

Cell["\<\
Here, we upload the equations of motion into the matrix corresponding to the \
principle part :\
\>", "Text",
 CellChangeTimes->{{3.894641547525032*^9, 
  3.8946415653313336`*^9}},ExpressionUUID->"93ca1c38-535d-4dae-ae62-\
8b49749e9b16"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Momentum", " ", "Conservation", " ", 
     SubscriptBox[
      SuperscriptBox["\[CapitalDelta]", "\[Mu]"], "\[Beta]"], 
     RowBox[{
      SubscriptBox["\[Del]", "\[Alpha]"], 
      SuperscriptBox["T", "\[Alpha]\[Beta]"]}]}], " ", "=", " ", 
    SuperscriptBox["0", "\[Mu]"]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"LMomentumVec", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"x", " ", "\[Delta]"}], ",", "NullTens", ",", "2"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LMomentumScalar", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         FractionBox[
          RowBox[{"V", "*", "P\[CurlyEpsilon]"}], 
          RowBox[{"\[CurlyEpsilon]", "+", "P"}]], "}"}], "]"}], ",", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         FractionBox[
          RowBox[{"V", "*", "Pn"}], 
          RowBox[{"\[CurlyEpsilon]", "+", "P"}]], "}"}], "]"}], ",", "2"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LMomentumEQ", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"LMomentumVec", ",", "LMomentumScalar", ",", "2"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "IS", " ", "relaxation", " ", "equation", " ", "for", " ", "particle", " ",
      "diffusion"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"JVec", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox["\[CapitalOmega]", "2"], 
         RowBox[{"TensorProduct", "[", 
          RowBox[{"\[ScriptCapitalJ]", ",", 
           RowBox[{"g", ".", "\[Phi]"}]}], "]"}]}], "-", 
        RowBox[{"\[CapitalOmega]", " ", "x", " ", 
         RowBox[{"TensorProduct", "[", 
          RowBox[{"U", ",", 
           RowBox[{"g", ".", "\[ScriptCapitalJ]"}]}], "]"}]}]}], ",", 
       RowBox[{"\[CapitalOmega]", " ", "x", " ", "\[Delta]"}], ",", "2"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"JScalar", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{"x", " ", "\[CapitalOmega]\[CurlyEpsilon]"}], "2"], 
           "\[ScriptCapitalJ]"}], "+", 
          RowBox[{"\[CapitalTheta]\[CurlyEpsilon]", " ", "V"}]}], "}"}], 
        "]"}], ",", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{"x", " ", "\[CapitalOmega]n"}], "2"], 
           "\[ScriptCapitalJ]"}], "+", 
          RowBox[{"\[CapitalTheta]n", " ", "V"}]}], "}"}], "]"}], ",", "2"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"JEQ", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"JVec", ",", "JScalar", ",", "2"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Energy", " ", "Conservation", " ", 
      SubscriptBox["u", "\[Beta]"], 
      RowBox[{
       SubscriptBox["\[Del]", "\[Alpha]"], 
       SuperscriptBox["T", "\[Alpha]\[Beta]"]}]}], " ", "=", " ", 
     SuperscriptBox["0", "\[Mu]"]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LEnergyEQ", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[CurlyEpsilon]", "+", "P"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{"g", ".", "\[Phi]"}], ")"}]}], ",", 
       RowBox[{"g", ".", "NullVec"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0"}], "}"}], ",", "1"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Baryon", " ", "Number", " ", "Conservation"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LBaryonEQ", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"n", 
        RowBox[{"(", 
         RowBox[{"g", ".", "\[Phi]"}], ")"}]}], ",", 
       RowBox[{"g", ".", "\[Phi]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "x"}], "}"}], ",", "1"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Combine", " ", "all", " ", "equations", " ", "into", " ", "the", " ", 
     "principle", " ", "part"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LPrincipalPart", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"LMomentumEQ", ",", "JEQ", ",", 
       RowBox[{"{", 
        RowBox[{"Transpose", "[", "LEnergyEQ", "]"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Transpose", "[", "LBaryonEQ", "]"}], "}"}], ",", "1"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LTotalDet", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Factor", "[", 
       RowBox[{"Det", "[", "LPrincipalPart", "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{"Cancel", "[", 
      FractionBox["LTotalDet", 
       RowBox[{
        SuperscriptBox["\[CapitalOmega]", "4"], " ", 
        SuperscriptBox["x", "6"]}]], "]"}], ",", "x", ",", "FullSimplify"}], 
    "]"}], "\[IndentingNewLine]", 
   RowBox[{"LPrincipalPart", "//", "MatrixForm"}]}]}]], "Input",
 CellChangeTimes->{{3.8945479946195498`*^9, 3.8945479948991165`*^9}, {
