       FractionBox["ETotalDet", 
        RowBox[{
         SuperscriptBox["x", "3"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", 
            FractionBox[
             RowBox[{"3", " ", "qbar", " ", 
              SuperscriptBox["\[CurlyEpsilon]", "2"], " ", "\[Psi]", " ", 
              "\[CapitalOmega]"}], 
             RowBox[{
              RowBox[{"9", " ", "n"}], " ", "-", 
              RowBox[{"4", " ", 
               SuperscriptBox["\[CurlyEpsilon]", "2"], " ", 
               "\[CapitalOmega]"}]}]]}], ")"}], "2"], 
         FractionBox[
          RowBox[{
           SuperscriptBox[
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "9"}], " ", "n"}], "+", 
              RowBox[{"4", " ", 
               SuperscriptBox["\[CurlyEpsilon]", "2"], " ", 
               "\[CapitalOmega]"}]}], ")"}], "3"], " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "9"}], " ", "n"}], "+", 
             RowBox[{
              SuperscriptBox["\[CurlyEpsilon]", "2"], " ", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"4", " ", "\[CapitalOmega]"}], "+", 
                RowBox[{"3", " ", 
                 SuperscriptBox["qbar", "2"], " ", "\[CurlyEpsilon]", " ", 
                 "\[CapitalOmega]\[CurlyEpsilon]"}]}], ")"}]}]}], ")"}]}], 
          RowBox[{"81", " ", 
           SuperscriptBox["\[CurlyEpsilon]", "4"], " ", 
           SuperscriptBox["\[CapitalOmega]", "4"]}]], " "}]], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"P", "->", 
          RowBox[{"\[CurlyEpsilon]", "/", "3"}]}], ",", 
         RowBox[{"T", "->", 
          FractionBox["\[CurlyEpsilon]", 
           RowBox[{"3", "n"}]]}], ",", 
         RowBox[{"T\[CurlyEpsilon]", "->", 
          FractionBox["1", 
           RowBox[{"3", "n"}]]}], ",", 
         RowBox[{"Tn", "->", 
          FractionBox[
           RowBox[{"-", "\[CurlyEpsilon]"}], 
           RowBox[{"3", 
            SuperscriptBox["n", "2"]}]]}], ",", 
         RowBox[{"Pn", "->", "0"}], ",", 
         RowBox[{"P\[CurlyEpsilon]", "->", 
          RowBox[{"1", "/", "3"}]}], ",", 
         RowBox[{"y", "->", 
          RowBox[{"\[Psi]", " ", "qbar", " ", "\[CurlyEpsilon]"}]}], ",", 
         RowBox[{"v", "->", "1"}], ",", 
         RowBox[{"q", "->", 
          RowBox[{"qbar", " ", "\[CurlyEpsilon]"}]}]}], "}"}]}], ")"}], "]"}],
     ",", "x", ",", "FullSimplify"}], "]"}]}]], "Input",
