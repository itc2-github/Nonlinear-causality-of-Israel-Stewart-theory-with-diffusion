Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"|B|/4 \[LessEqual] 1: \"\>", "\[InvisibleSpace]", 
   RowBox[{
    FractionBox["1", "8"], " ", 
    RowBox[{"Abs", "[", 
     FractionBox[
      RowBox[{"J", " ", "\[Psi]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", "Pn", " ", "\[CapitalOmega]"}], "+", 
         RowBox[{
          RowBox[{"(", 
