Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f2", "[", "y_", "]"}], ":=", 
   RowBox[{
    SuperscriptBox["y", "2"], "+", 
    RowBox[{"A1", " ", "y"}], "+", "A0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Collect", "[", 
  RowBox[{
   RowBox[{"f2", "[", 
    RowBox[{"1", "-", "z0"}], "]"}], ",", "z0", ",", "FullSimplify"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LLinCoeff", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"CoefficientList", "[", 
     RowBox[{
      RowBox[{"Cancel", "[", 
       RowBox[{"LLinQuadratic", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"v", "->", "1"}], ",", 
          RowBox[{"x", "->", 
           RowBox[{"Sqrt", "[", "y", "]"}]}], ",", 
          RowBox[{"P\[CurlyEpsilon]", "->", 
           RowBox[{
            SuperscriptBox["cs", "2"], "-", 
            FractionBox[
             RowBox[{"Pn", "*", "n"}], 
             RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}], ",", 
          RowBox[{"\[CapitalOmega]\[CurlyEpsilon]", "->", 
           RowBox[{"\[CapitalOmega]s", "-", 
            FractionBox[
             RowBox[{"\[CapitalOmega]n", "*", "n"}], 
             RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}], ",", 
          RowBox[{"\[CapitalTheta]\[CurlyEpsilon]", "->", 
           RowBox[{"\[CapitalTheta]s", "-", 
            FractionBox[
             RowBox[{"\[CapitalTheta]n", "*", "n"}], 
             RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}]}], "}"}]}], "]"}], ",",
       "y"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]LLin", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Discriminant", "[", 
     RowBox[{
      RowBox[{"Cancel", "[", 
       RowBox[{"LLinQuadratic", "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"v", "->", "1"}], ",", 
          RowBox[{"x", "->", 
           RowBox[{"Sqrt", "[", "y", "]"}]}], ",", 
          RowBox[{"P\[CurlyEpsilon]", "->", 
           RowBox[{
            SuperscriptBox["cs", "2"], "-", 
            FractionBox[
             RowBox[{"Pn", "*", "n"}], 
             RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}], ",", 
          RowBox[{"\[CapitalOmega]\[CurlyEpsilon]", "->", 
           RowBox[{"\[CapitalOmega]s", "-", 
            FractionBox[
             RowBox[{"\[CapitalOmega]n", "*", "n"}], 
             RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}], ",", 
          RowBox[{"\[CapitalTheta]\[CurlyEpsilon]", "->", 
           RowBox[{"\[CapitalTheta]s", "-", 
            FractionBox[
             RowBox[{"\[CapitalTheta]n", "*", "n"}], 
             RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}]}], "}"}]}], "]"}], ",",
       "y"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LLinA1", "=", 
   RowBox[{"LLinCoeff", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
