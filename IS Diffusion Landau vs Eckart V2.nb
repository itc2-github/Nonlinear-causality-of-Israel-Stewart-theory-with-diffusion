     RowBox[{
      SuperscriptBox["cs", "2"], " ", "\[CapitalOmega]"}]}], 
    "\[CapitalOmega]"]}],
  SequenceForm[
  "0 \[LessEqual] 1 + \!\(\*SubscriptBox[\(A\), \(0\)]\) + \
\!\(\*SubscriptBox[\(A\), \(1\)]\): 0 \[LessEqual] ", $CellContext`\
\[CapitalOmega]^(-1) ((-1 + $CellContext`cs^2) $CellContext`\[CapitalTheta]n - \
$CellContext`Pn $CellContext`\[CapitalTheta]s + $CellContext`\[CapitalOmega] - \
$CellContext`cs^2 $CellContext`\[CapitalOmega])],
  Editable->False]], "Print",
 CellChangeTimes->{{3.9506260401128216`*^9, 3.950626096030119*^9}, {
   3.950626160792494*^9, 3.950626174153076*^9}, 3.9506265223766174`*^9, 
