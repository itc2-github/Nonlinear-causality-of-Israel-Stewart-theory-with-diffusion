Cell[CellGroupData[{

Cell["Subcase: Ultrarelativistic Ideal Gas", "Section",
 CellChangeTimes->{{3.9484637861050453`*^9, 3.948463809234745*^9}, {
   3.948464728288599*^9, 3.9484647312451935`*^9}, 3.94846572025996*^9, {
   3.949688203697899*^9, 
   3.949688212885145*^9}},ExpressionUUID->"ac2c1956-d9dc-c14a-bd27-\
53b998c46586"],

Cell[TextData[{
 "Here are these two determinants for the ultrarelativistic ideal gas \
equation of state ",
 Cell[BoxData[
  FormBox[
   RowBox[{"nT", "=", 
    RowBox[{"P", "=", 
     RowBox[{"\[CurlyEpsilon]", "/", "3"}]}]}], TraditionalForm]],
  ExpressionUUID->"209d20e9-1f34-1446-a35a-63aafe468187"]
}], "Text",
 CellChangeTimes->{{3.9484662382208977`*^9, 
  3.94846628692021*^9}},ExpressionUUID->"2a53091f-0a27-8549-9bac-\
05748a0f9c55"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Collect", "[", 
  RowBox[{
   RowBox[{"Cancel", "[", 
    RowBox[{"Factor", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"3", "LTotalDet"}], 
       RowBox[{
        SuperscriptBox["\[CapitalOmega]", "4"], " ", 
        SuperscriptBox["x", "6"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", "1"}], "+", 
          RowBox[{"3", " ", 
           SuperscriptBox["x", "2"]}]}], ")"}]}]], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"y", "->", 
         RowBox[{"\[Psi]", " ", "J"}]}], ",", 
        RowBox[{"v", "->", "1"}], ",", 
        RowBox[{"P\[CurlyEpsilon]", "->", 
         RowBox[{"1", "/", "3"}]}], ",", 
        RowBox[{"P", "->", 
         RowBox[{"\[CurlyEpsilon]", "/", "3"}]}], ",", 
        RowBox[{"Pn", "->", "0"}], ",", 
        RowBox[{"\[CapitalTheta]n", "->", 
         RowBox[{"(*", 
          FractionBox["Pn", 
           RowBox[{"n", " ", "T"}]], "*)"}], 
         RowBox[{
          RowBox[{"-", 
           FractionBox[
            RowBox[{"4", 
             RowBox[{"\[CurlyEpsilon]", "/", "3"}]}], 
            RowBox[{"n", " ", 
             SuperscriptBox[
              RowBox[{"(", 
               FractionBox[
                RowBox[{"\[CurlyEpsilon]", "/", "3"}], "n"], ")"}], "2"]}]]}], 
          RowBox[{"(", 
           FractionBox[
            RowBox[{
             RowBox[{"-", "\[CurlyEpsilon]"}], "/", "3"}], 
            SuperscriptBox["n", "2"]], ")"}]}]}], ",", 
        RowBox[{"Tn", "->", 
         FractionBox[
          RowBox[{
           RowBox[{"-", "\[CurlyEpsilon]"}], "/", "3"}], 
          SuperscriptBox["n", "2"]]}], ",", 
        RowBox[{"T", "->", 
         FractionBox[
          RowBox[{"\[CurlyEpsilon]", "/", "3"}], "n"]}]}], "}"}]}], "]"}], 
    "]"}], ",", "x", ",", "FullSimplify"}], "]"}]], "Input",
 CellChangeTimes->{{3.9496854847206936`*^9, 3.9496854857283382`*^9}, {
  3.9500942288115196`*^9, 3.9500942324031525`*^9}, {3.9500942644040565`*^9, 
  3.9500942644682713`*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"ab0ac5c9-c651-f24b-a63b-7c8c9b40f580"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["x", "2"], "-", 
  FractionBox["4", 
   RowBox[{"n", " ", "\[CapitalOmega]"}]], "-", 
  FractionBox[
   RowBox[{"J", " ", "x", " ", "\[Psi]", " ", "\[CapitalOmega]n"}], 
   RowBox[{"2", " ", "\[CapitalOmega]"}]]}]], "Output",
 CellChangeTimes->{
  3.9496854865439205`*^9, {3.9497574067945576`*^9, 3.949757419660969*^9}, {
   3.950094236486908*^9, 3.950094265424261*^9}},
 CellLabel->"Out[28]=",ExpressionUUID->"205fc58a-1f71-4445-9dfe-ff7a8af97c79"]
}, Open  ]],

Cell["\<\
Let\[CloseCurlyQuote]s solve for the roots and discriminant of the 1 + 1 D \
case\
\>", "Text",
 CellChangeTimes->{{3.9491530207352962`*^9, 
  3.949153039578005*^9}},ExpressionUUID->"7f1d8444-fb11-5144-8c78-\
2b73f2d0f39c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox["x", "2"], "-", 
     FractionBox["4", 
      RowBox[{"n", " ", "\[CapitalOmega]"}]], "-", 
     FractionBox[
      RowBox[{"J", " ", "x", " ", "\[Psi]", " ", "\[CapitalOmega]n"}], 
      RowBox[{"2", " ", "\[CapitalOmega]"}]]}], "==", "0"}], ",", "x"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Discriminant", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox["x", "2"], "-", 
    FractionBox["4", 
     RowBox[{"n", " ", "\[CapitalOmega]"}]], "-", 
    FractionBox[
     RowBox[{"J", " ", "x", " ", "\[Psi]", " ", "\[CapitalOmega]n"}], 
     RowBox[{"2", " ", "\[CapitalOmega]"}]]}], ",", "x"}], "]"}]}], "Input",
 CellChangeTimes->{{3.949151964490267*^9, 3.949151976931711*^9}, {
  3.949596001355255*^9, 3.949596010117626*^9}, {3.949688283208416*^9, 
  3.9496882853683624`*^9}, {3.950094274862545*^9, 3.950094277568142*^9}},
 CellLabel->"In[29]:=",ExpressionUUID->"c015243b-8524-2f4d-a5f7-20270d6eef33"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", 
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{"J", " ", "\[Psi]", " ", "\[CapitalOmega]n"}], 
         "\[CapitalOmega]"], "-", 
        FractionBox[
         SqrtBox[
          RowBox[{
           RowBox[{"64", " ", "\[CapitalOmega]"}], "+", 
           RowBox[{
            SuperscriptBox["J", "2"], " ", "n", " ", 
            SuperscriptBox["\[Psi]", "2"], " ", 
            SuperscriptBox["\[CapitalOmega]n", "2"]}]}]], 
         RowBox[{
          SqrtBox["n"], " ", "\[CapitalOmega]"}]]}], ")"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", "\[Rule]", 
     RowBox[{
      FractionBox["1", "4"], " ", 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{"J", " ", "\[Psi]", " ", "\[CapitalOmega]n"}], 
         "\[CapitalOmega]"], "+", 
        FractionBox[
         SqrtBox[
          RowBox[{
           RowBox[{"64", " ", "\[CapitalOmega]"}], "+", 
           RowBox[{
            SuperscriptBox["J", "2"], " ", "n", " ", 
            SuperscriptBox["\[Psi]", "2"], " ", 
            SuperscriptBox["\[CapitalOmega]n", "2"]}]}]], 
         RowBox[{
          SqrtBox["n"], " ", "\[CapitalOmega]"}]]}], ")"}]}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{
  3.9491519781230087`*^9, {3.949688274340971*^9, 3.9496882874674892`*^9}, 
   3.949757422685255*^9, 3.950094278730524*^9},
 CellLabel->"Out[29]=",ExpressionUUID->"db9bae05-4684-094e-a6a6-192ed2bf42b5"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   RowBox[{"64", " ", "\[CapitalOmega]"}], "+", 
   RowBox[{
    SuperscriptBox["J", "2"], " ", "n", " ", 
    SuperscriptBox["\[Psi]", "2"], " ", 
    SuperscriptBox["\[CapitalOmega]n", "2"]}]}], 
  RowBox[{"4", " ", "n", " ", 
   SuperscriptBox["\[CapitalOmega]", "2"]}]]], "Output",
 CellChangeTimes->{
  3.9491519781230087`*^9, {3.949688274340971*^9, 3.9496882874674892`*^9}, 
   3.949757422685255*^9, 3.950094278733526*^9},
 CellLabel->"Out[30]=",ExpressionUUID->"f4b06d51-4063-e143-89f2-992a35748e29"]
}, Open  ]],

Cell[TextData[{
 "The above calculation holds the transport coefficients arbitrary.  We make \
the choice that ",
 Cell[BoxData[
  RowBox[{
   RowBox[{
    SubscriptBox["\[CapitalOmega]", "Landau"], "T"}], "->", 
   RowBox[{
    FractionBox[
     RowBox[{"5", "\[Lambda]"}], 
     RowBox[{"4", "P"}]], 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox[
       RowBox[{"\[CurlyEpsilon]", "+", "P"}], "n"], ")"}], "2"]}]}]],
  CellChangeTimes->{{3.9366957734577675`*^9, 3.936695774923628*^9}, {
    3.9367032079639225`*^9, 3.936703232838314*^9}, {3.9367032769031563`*^9, 
    3.93670329662059*^9}, {3.9367033524713593`*^9, 3.9367036101561966`*^9}, {
    3.936703681306444*^9, 3.9367037337448006`*^9}, {3.9367039371765404`*^9, 
    3.9367039517913895`*^9}, {3.9367041893090935`*^9, 
    3.9367041911184235`*^9}, {3.9367044904831467`*^9, 3.936704491693722*^9}, {
    3.936704665096962*^9, 3.9367046670007744`*^9}, {3.9367047814648285`*^9, 
    3.9367048179038277`*^9}, {3.936704988956169*^9, 3.9367049912566395`*^9}, 
    3.9367050279488106`*^9, 3.936705128223114*^9, 3.937567992327423*^9, {
    3.937568197082762*^9, 3.9375681977883606`*^9}, {3.937568277090637*^9, 
    3.9375683481697407`*^9}},ExpressionUUID->
  "17aa64c1-e9af-4540-b050-aa07003084fe"],
 " and use the ultrarelativistic EoS P(\[CurlyEpsilon]) ",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", " ", 
    FractionBox["\[CurlyEpsilon]", "3"]}], TraditionalForm]],ExpressionUUID->
  "c3db92e7-1e98-3c41-a929-ee0cdf28090a"],
 " with the ideal gas law P = nT. One then finds that ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", "Landau"], " ", "=", " ", 
    FractionBox[
     RowBox[{"20", " ", "\[Lambda]"}], "n"]}], TraditionalForm]],
  ExpressionUUID->"c9c3b27a-65d0-b64b-9b1e-dc56ac85e165"],
 ". Further note that by the first law,\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalTheta]", "n"], "=", 
    RowBox[{
     FractionBox[
      SubscriptBox["P", "n"], 
      RowBox[{"n", " ", "T"}]], "-", 
     RowBox[{
      FractionBox[
       RowBox[{"\[CurlyEpsilon]", "+", "P"}], 
       RowBox[{"n", " ", 
        SuperscriptBox["T", "2"]}]], 
      SubscriptBox["T", "n"]}]}]}], TraditionalForm]],ExpressionUUID->
  "cc3f0628-364a-4f46-9199-1399b8913f60"]
}], "Text",
 CellChangeTimes->{{3.9421656283870697`*^9, 3.94216588164427*^9}, {
  3.942166017382887*^9, 3.9421660199494057`*^9}, {3.942166682706829*^9, 
  3.9421667580776653`*^9}, {3.94224223108313*^9, 3.942242266631151*^9}, {
  3.9496886394817467`*^9, 
  3.949688729187479*^9}},ExpressionUUID->"924a548e-f403-3f4c-91e1-\
00179435cfac"],

