Cell[CellGroupData[{

Cell["Landau Principle Part", "Chapter",
 CellChangeTimes->{{3.8946415289653344`*^9, 3.8946415351670837`*^9}, {
  3.9354263025796967`*^9, 
  3.9354263037380543`*^9}},ExpressionUUID->"37a035f8-bdad-41aa-82b6-\
9c1e6a61a2d8"],

Cell["\<\
Here, we upload the equations of motion into the matrix corresponding to the \
principle part :\
\>", "Text",
 CellChangeTimes->{{3.894641547525032*^9, 
  3.8946415653313336`*^9}},ExpressionUUID->"93ca1c38-535d-4dae-ae62-\
8b49749e9b16"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"Momentum", " ", "Conservation", " ", 
     SubscriptBox[
      SuperscriptBox["\[CapitalDelta]", "\[Mu]"], "\[Beta]"], 
     RowBox[{
      SubscriptBox["\[Del]", "\[Alpha]"], 
      SuperscriptBox["T", "\[Alpha]\[Beta]"]}]}], " ", "=", " ", 
    SuperscriptBox["0", "\[Mu]"]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"LMomentumVec", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"x", " ", "\[Delta]"}], ",", "NullTens", ",", "2"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LMomentumScalar", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         FractionBox[
          RowBox[{"V", "*", "P\[CurlyEpsilon]"}], 
          RowBox[{"\[CurlyEpsilon]", "+", "P"}]], "}"}], "]"}], ",", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         FractionBox[
          RowBox[{"V", "*", "Pn"}], 
          RowBox[{"\[CurlyEpsilon]", "+", "P"}]], "}"}], "]"}], ",", "2"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LMomentumEQ", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"LMomentumVec", ",", "LMomentumScalar", ",", "2"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "IS", " ", "relaxation", " ", "equation", " ", "for", " ", "particle", " ",
      "diffusion"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"JVec", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         FractionBox["\[CapitalOmega]", "2"], 
         RowBox[{"TensorProduct", "[", 
          RowBox[{"\[ScriptCapitalJ]", ",", 
           RowBox[{"g", ".", "\[Phi]"}]}], "]"}]}], "-", 
        RowBox[{"\[CapitalOmega]", " ", "x", " ", 
         RowBox[{"TensorProduct", "[", 
          RowBox[{"U", ",", 
           RowBox[{"g", ".", "\[ScriptCapitalJ]"}]}], "]"}]}]}], ",", 
       RowBox[{"\[CapitalOmega]", " ", "x", " ", "\[Delta]"}], ",", "2"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"JScalar", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{"x", " ", "\[CapitalOmega]\[CurlyEpsilon]"}], "2"], 
           "\[ScriptCapitalJ]"}], "+", 
          RowBox[{"\[CapitalTheta]\[CurlyEpsilon]", " ", "V"}]}], "}"}], 
        "]"}], ",", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           FractionBox[
            RowBox[{"x", " ", "\[CapitalOmega]n"}], "2"], 
           "\[ScriptCapitalJ]"}], "+", 
          RowBox[{"\[CapitalTheta]n", " ", "V"}]}], "}"}], "]"}], ",", "2"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"JEQ", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"JVec", ",", "JScalar", ",", "2"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Energy", " ", "Conservation", " ", 
      SubscriptBox["u", "\[Beta]"], 
      RowBox[{
       SubscriptBox["\[Del]", "\[Alpha]"], 
       SuperscriptBox["T", "\[Alpha]\[Beta]"]}]}], " ", "=", " ", 
     SuperscriptBox["0", "\[Mu]"]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LEnergyEQ", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"\[CurlyEpsilon]", "+", "P"}], ")"}], "*", 
        RowBox[{"(", 
         RowBox[{"g", ".", "\[Phi]"}], ")"}]}], ",", 
       RowBox[{"g", ".", "NullVec"}], ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0"}], "}"}], ",", "1"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Baryon", " ", "Number", " ", "Conservation"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LBaryonEQ", "=", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"n", 
        RowBox[{"(", 
         RowBox[{"g", ".", "\[Phi]"}], ")"}]}], ",", 
       RowBox[{"g", ".", "\[Phi]"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "x"}], "}"}], ",", "1"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Combine", " ", "all", " ", "equations", " ", "into", " ", "the", " ", 
     "principle", " ", "part"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LPrincipalPart", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"LMomentumEQ", ",", "JEQ", ",", 
       RowBox[{"{", 
        RowBox[{"Transpose", "[", "LEnergyEQ", "]"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"Transpose", "[", "LBaryonEQ", "]"}], "}"}], ",", "1"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"LTotalDet", "=", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"Factor", "[", 
      RowBox[{"Det", "[", "LPrincipalPart", "]"}], "]"}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[CapitalTheta]\[CurlyEpsilon]", "->", 
         RowBox[{
          FractionBox[
           RowBox[{"1", "+", "P\[CurlyEpsilon]"}], 
           RowBox[{"n", " ", "T"}]], "-", 
          FractionBox[
           RowBox[{"\[CurlyEpsilon]", "+", "P"}], 
           RowBox[{"n", " ", 
            SuperscriptBox["T", "2"]}]], "-", "s\[CurlyEpsilon]"}]}], ",", 
        RowBox[{"\[CapitalTheta]n", "->", 
         RowBox[{
          FractionBox["Pn", 
           RowBox[{"n", " ", "T"}]], "-", 
          RowBox[{
           FractionBox[
            RowBox[{"\[CurlyEpsilon]", "+", "P"}], 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"n", " ", "T"}], ")"}], "2"]], 
           RowBox[{"(", 
            RowBox[{"T", "+", 
             RowBox[{"n", " ", "Tn"}]}], ")"}]}], "-", "sn"}]}]}], "}"}]}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"P\[CurlyEpsilon]", "->", 
        RowBox[{
         SuperscriptBox["cs", "2"], "-", 
         FractionBox[
          RowBox[{"Pn", "*", "n"}], 
          RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}], ",", 
       RowBox[{"B\[CurlyEpsilon]", "->", 
        RowBox[{"Bs", "-", 
         FractionBox[
          RowBox[{"Bn", "*", "n"}], 
          RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}], ",", 
       RowBox[{"\[CapitalTheta]\[CurlyEpsilon]", "->", 
        RowBox[{"\[CapitalTheta]s", "-", 
         FractionBox[
          RowBox[{"\[CapitalTheta]n", "*", "n"}], 
          RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}]}], "}"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Collect", "[", 
    RowBox[{
     RowBox[{"Cancel", "[", 
      FractionBox["LTotalDet", 
       RowBox[{
        SuperscriptBox["\[CapitalOmega]", "4"], " ", 
        SuperscriptBox["x", "6"]}]], "]"}], ",", "x", ",", "FullSimplify"}], 
    "]"}], "\[IndentingNewLine]", 
   RowBox[{"LPrincipalPart", "//", "MatrixForm"}]}]}]], "Input",
 CellChangeTimes->{{3.8945479946195498`*^9, 3.8945479948991165`*^9}, {
   3.8945481302806616`*^9, 3.894548248003029*^9}, {3.8945483272480993`*^9, 
   3.894548329557625*^9}, {3.8945487364722033`*^9, 3.894548791994069*^9}, {
   3.8945488442758694`*^9, 3.894548865724622*^9}, {3.8945488982298803`*^9, 
   3.8945489946724863`*^9}, {3.894549361339327*^9, 3.8945495073391724`*^9}, {
   3.894549637571122*^9, 3.8945496687797775`*^9}, {3.8945497134944177`*^9, 
   3.894549882846987*^9}, {3.894549919440325*^9, 3.8945499685156236`*^9}, {
   3.894550007602259*^9, 3.8945501948069925`*^9}, {3.894550382905637*^9, 
   3.894550410889757*^9}, {3.894550614301726*^9, 3.894550683094987*^9}, {
   3.894550717606801*^9, 3.894550788156147*^9}, {3.894550836717683*^9, 
