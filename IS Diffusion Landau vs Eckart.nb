        RowBox[{"20", " ", "\[Lambda]"}], "n"]}], ",", 
      RowBox[{"\[CapitalOmega]\[CurlyEpsilon]", "->", "0"}], ",", 
      RowBox[{"\[CapitalOmega]n", "->", 
       RowBox[{"-", 
        FractionBox[
         RowBox[{"20", " ", "\[Lambda]"}], 
         SuperscriptBox["n", "2"]]}]}]}], "}"}]}], ",", "x"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"FullSimplify", "[", 
  RowBox[{"Solve", "[", 
   RowBox[{
    RowBox[{
