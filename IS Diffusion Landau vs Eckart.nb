Cell[TextData[{
 "Below, we calculate the determinant in the Eckart frame for an \
ultrarelativistic ideal gas such that P ",
 Cell[BoxData[
  FormBox[
   RowBox[{"=", " ", 
    FractionBox["\[CurlyEpsilon]", "3"]}], TraditionalForm]],ExpressionUUID->
  "852d092b-7f3b-1c4e-b9a4-76faabb8fe2e"],
 " and P = nT. The quartic below reproduces their results exactly. Note we \
are using units of v = 1, which can be interpreted as incorporating the \
substitution x ",
 Cell[BoxData[
  FormBox[
   RowBox[{"->", " ", 
    FractionBox["x", "v"]}], TraditionalForm]],ExpressionUUID->
  "9599a2ee-2acc-e146-98ba-d4f21fbb1805"],
 " and then dividing by ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["v", "10"], TraditionalForm]],ExpressionUUID->
  "a4d68ab9-06b9-7c4a-9c44-57a1b4694b56"],
 "."
}], "Text",
 CellChangeTimes->{{3.9421652116246967`*^9, 3.942165373289427*^9}, {
  3.942165428957041*^9, 3.942165473909155*^9}, {3.9496890856860733`*^9, 
  3.9496890899404907`*^9}, {3.9496891597613983`*^9, 3.9496892429230347`*^9}, {
  3.949691488320284*^9, 
  3.949691518746132*^9}},ExpressionUUID->"22bcc706-09c4-4b46-a188-\
0311523bb656"],

