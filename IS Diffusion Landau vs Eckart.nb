     FractionBox["3", "8"], 
     SuperscriptBox["LB", "2"]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"\[Delta]0L", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    SuperscriptBox["LC", "2"], "-", 
    RowBox[{"3", "LB", " ", "LD"}], "+", 
    RowBox[{"12", "LE"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"\[Delta]1L", "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"4", "LE"}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["LB", "2"], "-", "LC"}], ")"}], "LC"}], "-", 
    RowBox[{"LB", " ", "LD"}], "-", 
    RowBox[{
     FractionBox["3", "16"], 
     SuperscriptBox["LB", "4"]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]L", "=", 
   RowBox[{"Discriminant", "[", 
    RowBox[{
     RowBox[{"Cancel", "[", 
      RowBox[{
       FractionBox["LTotalDet", 
        RowBox[{
         SuperscriptBox["\[CapitalOmega]", "4"], " ", 
         SuperscriptBox["x", "6"]}]], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"v", "->", "1"}], ",", 
         RowBox[{"y", "->", 
          RowBox[{"\[Psi]", " ", "J"}]}], ",", 
         RowBox[{"P\[CurlyEpsilon]", "->", 
          RowBox[{
           SuperscriptBox["cs", "2"], "-", 
           FractionBox[
            RowBox[{"Pn", "*", "n"}], 
            RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}], ",", 
         RowBox[{"\[CapitalOmega]\[CurlyEpsilon]", "->", 
          RowBox[{"\[CapitalOmega]sn", "-", 
           FractionBox[
            RowBox[{"\[CapitalOmega]n", "*", "n"}], 
            RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}], ",", 
         RowBox[{"\[CapitalTheta]\[CurlyEpsilon]", "->", 
          RowBox[{"\[CapitalTheta]sn", "-", 
