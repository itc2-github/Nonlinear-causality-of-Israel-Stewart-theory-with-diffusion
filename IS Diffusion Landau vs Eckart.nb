Cell["\<\
The causality conditions (aside from those pertaining to the discriminant) are\
\>", "Text",
 CellChangeTimes->{{3.9431095439660835`*^9, 
  3.9431095607825413`*^9}},ExpressionUUID->"c85090b8-caf4-a844-9efd-\
752ab2382771"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{"(*", " ", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
    "\[Lambda]0val", " ", "IS", " ", "THE", " ", "VALUE", " ", "OF", " ", 
     "\[Lambda]0"}], ";", "\[IndentingNewLine]", 
    RowBox[{
    "\[Psi]val", " ", "IS", " ", "THE", " ", "VALUE", " ", "OF", " ", 
     "\[Psi]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"ranges", " ", "from"}], " ", "-", 
       RowBox[{"1", " ", "to"}], " ", "+", "1"}], ")"}]}]}], 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Lambda]0val", "=", "\[Lambda]0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Psi]val", "=", 
     RowBox[{"-", "1"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Coefficient", " ", "list", " ", "for", " ", "the", " ", "coefficients", " ",
      "of", " ", "the", " ", "quartic", " ", "polynomial"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"URCoeff", "=", 
     RowBox[{"CoefficientList", "[", 
      RowBox[{
       RowBox[{"Cancel", "[", 
        RowBox[{
         RowBox[{"(", 
          FractionBox["UREckartQuintic", 
           RowBox[{"x", "-", 
            FractionBox[
             RowBox[{
             "15", " ", "\[Psi]", " ", "qbar", " ", "\[Lambda]0", " "}], 
             RowBox[{"4", "-", 
              RowBox[{"20", " ", "\[Lambda]0"}]}]]}]], ")"}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Lambda]0", "->", "\[Lambda]0val"}], ",", 
           RowBox[{"\[Psi]", "->", "\[Psi]val"}]}], "}"}]}], "]"}], ",", 
       "x"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Useful", " ", "definitions", " ", "of", " ", "terms", " ", "for", " ", 
     "causality"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"A2URtilde", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"URCoeff", "[", 
          RowBox[{"[", "3", "]"}], "]"}], "-", 
         RowBox[{
          FractionBox["3", "8"], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"URCoeff", "[", 
             RowBox[{"[", "4", "]"}], "]"}], ")"}], "2"]}]}], ")"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Lambda]0", "->", "\[Lambda]0val"}], ",", 
         RowBox[{"\[Psi]", "->", "\[Psi]val"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Delta]0UR", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"URCoeff", "[", 
            RowBox[{"[", "3", "]"}], "]"}], ")"}], "2"], "-", 
         RowBox[{"3", 
          RowBox[{"URCoeff", "[", 
           RowBox[{"[", "4", "]"}], "]"}], 
          RowBox[{"URCoeff", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "+", 
         RowBox[{"12", 
          RowBox[{"URCoeff", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}]}], ")"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Lambda]0", "->", "\[Lambda]0val"}], ",", 
         RowBox[{"\[Psi]", "->", "\[Psi]val"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Delta]1UR", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"4", 
          RowBox[{"URCoeff", "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"URCoeff", "[", 
               RowBox[{"[", "4", "]"}], "]"}], ")"}], "2"], "-", 
            RowBox[{"URCoeff", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ")"}], 
          RowBox[{"URCoeff", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"URCoeff", "[", 
           RowBox[{"[", "4", "]"}], "]"}], " ", 
          RowBox[{"URCoeff", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "-", 
         RowBox[{
          FractionBox["3", "16"], 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"URCoeff", "[", 
             RowBox[{"[", "4", "]"}], "]"}], ")"}], "4"]}]}], ")"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Lambda]0", "->", "\[Lambda]0val"}], ",", 
         RowBox[{"\[Psi]", "->", "\[Psi]val"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalDelta]UR", "=", 
     RowBox[{"Discriminant", "[", 
      RowBox[{
       RowBox[{"Cancel", "[", 
        RowBox[{
         RowBox[{"(", 
          FractionBox["UREckartQuintic", 
           RowBox[{"x", "-", 
            FractionBox[
             RowBox[{
             "15", " ", "\[Psi]", " ", "qbar", " ", "\[Lambda]0", " "}], 
             RowBox[{"4", "-", 
              RowBox[{"20", " ", "\[Lambda]0"}]}]]}]], ")"}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Lambda]0", "->", "\[Lambda]0val"}], ",", 
           RowBox[{"\[Psi]", "->", "\[Psi]val"}]}], "}"}]}], "]"}], ",", 
       "x"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Here", " ", "we", " ", "bind", " ", "the", " ", "characteristic", " ", 
     "speed", " ", "that", " ", "is", " ", "not", " ", "part", " ", "of", " ",
      "the", " ", "quartic", " ", "by", " ", "unity"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<|\!\(\*FractionBox[\(q\), \(\[CurlyEpsilon] + P - \
\*FractionBox[\(1\), \(\*SubscriptBox[\(\[CapitalOmega]\), \(q\)] T\)]\)]\)| \
\[LessEqual] 1: \>\"", ",", 
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         FractionBox[
          RowBox[{"qbar", " ", "\[CurlyEpsilon]"}], 
          RowBox[{"\[CurlyEpsilon]", "+", "P", "-", 
           FractionBox["1", 
            RowBox[{"\[CapitalOmega]", " ", "T"}]]}]], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"P", "->", 
            RowBox[{"\[CurlyEpsilon]", "/", "3"}]}], ",", 
           RowBox[{"T", "->", 
            FractionBox["\[CurlyEpsilon]", 
             RowBox[{"3", "n"}]]}], ",", 
           RowBox[{"\[CapitalOmega]", "->", 
            FractionBox[
             RowBox[{"45", "n", " ", "\[Lambda]0"}], 
             RowBox[{"4", " ", 
              SuperscriptBox["\[CurlyEpsilon]", "2"]}]]}]}], "}"}]}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{"\[Lambda]0", "->", "\[Lambda]0val"}], "}"}]}], "]"}], 
     ",", "\"\< \[LessEqual] 1\>\""}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Next", ",", " ", 
     RowBox[{
     "we", " ", "list", " ", "the", " ", "conditions", " ", "that", " ", 
      "bind", " ", "the", " ", "quartic", " ", "roots", " ", "by", " ", 
      "unity"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<|\!\(\*SubscriptBox[\(A\), \(3\)]\)|/4 \[LessEqual] 1: \>\"",
      ",", 
     RowBox[{"Abs", "[", 
      RowBox[{"FullSimplify", "[", 
       FractionBox[
        RowBox[{"URCoeff", "[", 
         RowBox[{"[", "4", "]"}], "]"}], "4"], "]"}], "]"}], 
     ",", "\"\< \[LessEqual] 1\>\""}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<|\!\(\*SubscriptBox[\(A\), \(3\)]\)|/4 \[LessEqual] \
\!\(\*FractionBox[\(1\), \(12\)]\)(6 + \!\(\*SubscriptBox[\(A\), \(2\)]\)): \
\>\"", ",", 
     RowBox[{"Abs", "[", 
      RowBox[{"FullSimplify", "[", 
       FractionBox[
        RowBox[{"URCoeff", "[", 
         RowBox[{"[", "4", "]"}], "]"}], "4"], "]"}], "]"}], 
     ",", "\"\< \[LessEqual] \>\"", ",", 
     RowBox[{"FullSimplify", "[", 
      FractionBox[
       RowBox[{"6", "+", 
        RowBox[{"URCoeff", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], "12"], "]"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<\!\(\*FractionBox[\( | \(\*SubscriptBox[\(A\), \(1\)] + 3 \
\*SubscriptBox[\(A\), \(3\)]\)\(|\)\), \(4\)]\) \[LessEqual] 1 + \
\!\(\*FractionBox[SubscriptBox[\(A\), \(2\)], \(2\)]\): \>\"", ",", 
     RowBox[{"Abs", "[", 
      RowBox[{"FullSimplify", "[", 
       FractionBox[
        RowBox[{
         RowBox[{"URCoeff", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "+", 
         RowBox[{"3", 
          RowBox[{"URCoeff", "[", 
           RowBox[{"[", "4", "]"}], "]"}]}]}], "4"], "]"}], "]"}], 
     ",", "\"\< \[LessEqual] \>\"", ",", 
     RowBox[{"FullSimplify", "[", 
      FractionBox[
       RowBox[{"2", "+", 
        RowBox[{"URCoeff", "[", 
         RowBox[{"[", "3", "]"}], "]"}]}], "2"], "]"}]}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<|\!\(\*SubscriptBox[\(A\), \(1\)]\) + \!\(\*SubscriptBox[\(A\
\), \(3\)]\)| \[LessEqual] 1 + \!\(\*SubscriptBox[\(A\), \(0\)]\) + \
\!\(\*SubscriptBox[\(A\), \(2\)]\): \>\"", ",", 
     RowBox[{"Abs", "[", 
      RowBox[{"FullSimplify", "[", 
       RowBox[{
        RowBox[{"URCoeff", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "+", 
        RowBox[{"URCoeff", "[", 
         RowBox[{"[", "4", "]"}], "]"}]}], "]"}], "]"}], 
     ",", "\"\< \[LessEqual] \>\"", ",", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"1", "+", 
       RowBox[{"URCoeff", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "+", 
       RowBox[{"URCoeff", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Finally", " ", "we", " ", "ask", " ", "Mathematica", " ", "to", " ", 
      "solve", " ", "these", " ", "inequalities", " ", "simultaneously"}], ",",
      " ", 
     RowBox[{
     "also", " ", "using", " ", "the", " ", "conditions", " ", "for", " ", 
      "a", " ", "quartic", " ", "polynomial", " ", "to", " ", "have", " ", 
      "real", " ", "roots"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
   "Print", "[", "\"\<The Full List of Conditions Simplifies to:\>\"", "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Reduce", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"qbar", ">", "0"}], "&&", 
      RowBox[{"\[Lambda]0", ">=", 
       RowBox[{"1", "/", "5"}]}], "\[IndentingNewLine]", "&&", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"FullSimplify", "[", 
          RowBox[{
           FractionBox[
            RowBox[{"qbar", " ", "\[CurlyEpsilon]"}], 
            RowBox[{"\[CurlyEpsilon]", "+", "P", "-", 
             FractionBox["1", 
              RowBox[{"\[CapitalOmega]", " ", "T"}]]}]], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"P", "->", 
              RowBox[{"\[CurlyEpsilon]", "/", "3"}]}], ",", 
             RowBox[{"T", "->", 
              FractionBox["\[CurlyEpsilon]", 
               RowBox[{"3", "n"}]]}], ",", 
             RowBox[{"\[CapitalOmega]", "->", 
              FractionBox[
               RowBox[{"45", "n", " ", "\[Lambda]0"}], 
               RowBox[{"4", " ", 
                SuperscriptBox["\[CurlyEpsilon]", "2"]}]]}]}], "}"}]}], "]"}],
          "/.", 
         RowBox[{"{", 
          RowBox[{"\[Lambda]0", "->", "\[Lambda]0val"}], "}"}]}], "]"}], "\[LessEqual]",
        " ", "1"}], "\[IndentingNewLine]", "&&", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"FullSimplify", "[", 
         FractionBox[
          RowBox[{"URCoeff", "[", 
           RowBox[{"[", "4", "]"}], "]"}], "4"], "]"}], "]"}], "\[LessEqual]",
        " ", "1"}], "\[IndentingNewLine]", "&&", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"FullSimplify", "[", 
         FractionBox[
          RowBox[{"URCoeff", "[", 
           RowBox[{"[", "4", "]"}], "]"}], "4"], "]"}], "]"}], "\[LessEqual]",
        " ", 
       RowBox[{"FullSimplify", "[", 
        FractionBox[
         RowBox[{"6", "+", 
          RowBox[{"URCoeff", "[", 
           RowBox[{"[", "3", "]"}], "]"}]}], "12"], "]"}]}], 
      "\[IndentingNewLine]", "&&", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"URCoeff", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "+", 
            RowBox[{"3", 
             RowBox[{"URCoeff", "[", 
              RowBox[{"[", "4", "]"}], "]"}]}]}], ")"}], "/", "4"}], "]"}], 
        "]"}], "<=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "+", 
           RowBox[{"URCoeff", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ")"}], "/", "2"}], "]"}]}], 
      "\[IndentingNewLine]", "&&", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"FullSimplify", "[", 
         RowBox[{
          RowBox[{"URCoeff", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "+", 
          RowBox[{"URCoeff", "[", 
           RowBox[{"[", "4", "]"}], "]"}]}], "]"}], "]"}], "<=", 
       RowBox[{"FullSimplify", "[", 
        RowBox[{"1", "+", 
         RowBox[{"URCoeff", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "+", 
         RowBox[{"URCoeff", "[", 
          RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", "&&",
       "\[IndentingNewLine]", 
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
