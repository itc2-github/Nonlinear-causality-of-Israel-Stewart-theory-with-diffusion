Cell[BoxData[{
 RowBox[{"FullSimplify", "[", 
  RowBox[{
   RowBox[{
    SuperscriptBox["x", "2"], "-", 
    FractionBox["4", 
     RowBox[{"n", " ", "\[CapitalOmega]"}]], "-", 
    FractionBox[
     RowBox[{"J", " ", "x", " ", "\[Psi]", " ", "\[CapitalOmega]n"}], 
     RowBox[{"2", " ", "\[CapitalOmega]"}]]}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[CapitalOmega]", "->", " ", 
      FractionBox[
       RowBox[{"20", " ", "\[Lambda]"}], "n"]}], ",", 
     RowBox[{"\[CapitalOmega]\[CurlyEpsilon]", "->", "0"}], ",", 
     RowBox[{"\[CapitalOmega]n", "->", 
      RowBox[{"-", 
