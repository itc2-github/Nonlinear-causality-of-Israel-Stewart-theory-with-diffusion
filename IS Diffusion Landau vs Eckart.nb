         RowBox[{"\[CapitalOmega]n", "->", 
          RowBox[{"-", 
           FractionBox[
            RowBox[{"20", " ", "\[Lambda]"}], 
            SuperscriptBox["n", "2"]]}]}]}], "}"}]}], ")"}], "==", "0"}], ",",
     "x"}], "]"}], "]"}]}], "Input",
