Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Print", "[", 
  RowBox[{
  "\"\<|\!\(\*SubscriptBox[\(A\), \(4\)]\)|/5 \[LessEqual] 1: \>\"", ",", 
   RowBox[{"Abs", "[", 
    RowBox[{"FullSimplify", "[", 
     FractionBox["E4", "5"], "]"}], "]"}], ",", "\"\< \[LessEqual] 1\>\""}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{
  "\"\<|\!\(\*SubscriptBox[\(A\), \(4\)]\)| \[LessEqual] 10 + \
\!\(\*SubscriptBox[\(A\), \(3\)]\): \>\"", " ", ",", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"4", "E4"}], "]"}], "\[LessEqual]", 
     RowBox[{"10", "+", "E3"}]}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{
  "\"\<|\!\(\*SubscriptBox[\(A\), \(2\)]\) + 6\!\(\*SubscriptBox[\(A\), \
\(4\)]\)| \[LessEqual] 10 + 3\!\(\*SubscriptBox[\(A\), \(3\)]\): \>\"", ",", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"E2", "+", 
       RowBox[{"6", "E4"}]}], "]"}], "\[LessEqual]", 
     RowBox[{"10", "+", 
      RowBox[{"3", "E3"}]}]}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{
  "\"\<|2\!\(\*SubscriptBox[\(A\), \(2\)]\) + 4\!\(\*SubscriptBox[\(A\), \
\(4\)]\)| \[LessEqual] 5 + \!\(\*SubscriptBox[\(A\), \(1\)]\) + \
3\!\(\*SubscriptBox[\(A\), \(3\)]\): \>\"", ",", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{
       RowBox[{"2", "E2"}], "+", 
       RowBox[{"4", "E4"}]}], "]"}], "\[LessEqual]", 
     RowBox[{"5", "+", "E1", "+", 
      RowBox[{"3", "E3"}]}]}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{
  "\"\<|\!\(\*SubscriptBox[\(A\), \(0\)]\) + \!\(\*SubscriptBox[\(A\), \(2\)]\
\) + \!\(\*SubscriptBox[\(A\), \(4\)]\)| \[LessEqual] 1 + \!\(\*SubscriptBox[\
\(A\), \(1\)]\) + \!\(\*SubscriptBox[\(A\), \(3\)]\): \>\"", ",", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"E0", "+", "E2", "+", "E4"}], "]"}], "\[LessEqual]", 
     RowBox[{"1", "+", "E1", "+", "E3"}]}], "]"}]}], "]"}]}], "Input",
