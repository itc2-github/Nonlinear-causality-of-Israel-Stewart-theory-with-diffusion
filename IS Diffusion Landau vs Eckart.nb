Cell[CellGroupData[{

Cell["Global Vector + Function Definitions (COMPILE FIRST)", "Chapter",
 CellChangeTimes->{{3.894544841418065*^9, 3.894544854328527*^9}, {
  3.894634815837508*^9, 3.8946348178392467`*^9}, {3.894635090762486*^9, 
  3.894635094596484*^9}},ExpressionUUID->"59287415-d9b9-4bbc-afb0-\
b7a52e42be02"],

Cell[TextData[{
 "Define the metric, four-velocity ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["u", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "df13ccc9-67a3-47af-9f9f-b0e08ef31085"],
 ", reduced magnetic field ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["b", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "cfca3bfa-3083-4144-8027-c63075ae9149"],
 ", and characteristic vectors ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["\[Phi]", "\[Mu]"], TraditionalForm]],ExpressionUUID->
  "61f4cce4-c569-4f48-a3d9-ad03a7503b79"],
 ", along with covariant forms. Assume that all global vectors V have ",
 StyleBox["raised",
  FontWeight->"Bold"],
 " indices (which can be lowered by g.V) and all global tensors have ",
 StyleBox["lowered",
  FontWeight->"Bold"],
 " indices except for \[Delta], which is of the form ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    SuperscriptBox["\[Delta]", "\[Mu]"], "\[Nu]"], TraditionalForm]],
  ExpressionUUID->"e391b153-cf2e-4127-b6f0-0a5ccc1a4315"],
 ". "
}], "Text",
 CellChangeTimes->{{3.89454492306317*^9, 3.894545115784341*^9}, {
  3.894546559908344*^9, 3.894546595590561*^9}, {3.894550445823617*^9, 
  3.894550451083196*^9}, {3.894550504296565*^9, 
  3.8945505328106227`*^9}},ExpressionUUID->"38b87332-0cb6-41f6-957f-\
abee0837471f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Metric", " ", "and", " ", "Identity", " ", "Tensor"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"g", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "1"}], ",", "0", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "1", ",", "0", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "1", ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";"}], 
   " ", 
   RowBox[{"(*", " ", 
    RowBox[{"metric", " ", 
     SubscriptBox["g", "\[Mu]\[Nu]"]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ginv", "=", 
     RowBox[{"Inverse", "[", "g", "]"}]}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{"inverse", " ", "metric", " ", 
     SuperscriptBox["g", "\[Mu]\[Nu]"]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Delta]", "=", 
     RowBox[{"ginv", ".", "g"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"Null", " ", "Vector", " ", "and", " ", "Null", " ", "Tensor"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"NullVec", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"NullTens", "=", 
     RowBox[{"TensorProduct", "[", 
      RowBox[{
       RowBox[{"g", ".", "NullVec"}], ",", 
       RowBox[{"g", ".", "NullVec"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Dynamic", " ", "4"}], "-", "Vectors"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"U", "=", 
     RowBox[{"{", 
      RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[ScriptCapitalJ]", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0", ",", "J"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Projection", " ", "tensors", " ", "orthogonal", " ", "to", " ", 
      SuperscriptBox["u", "\[Mu]"]}], ",", " ", 
     RowBox[{"and", " ", "both", " ", 
      SuperscriptBox["u", "\[Mu]"], " ", "and", " ", 
      SuperscriptBox["b", 
       RowBox[{"\[Mu]", " "}]]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalDelta]", "=", 
     RowBox[{"g", "+", 
      RowBox[{"TensorProduct", "[", 
       RowBox[{
        RowBox[{"g", ".", "U"}], ",", 
        RowBox[{"g", ".", "U"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[CapitalDelta]\[ScriptCapitalJ]", "=", 
     RowBox[{"\[CapitalDelta]", "-", 
      FractionBox[
       RowBox[{"TensorProduct", "[", 
        RowBox[{
         RowBox[{"g", ".", "\[ScriptCapitalJ]"}], ",", 
         RowBox[{"g", ".", "\[ScriptCapitalJ]"}]}], "]"}], 
       SuperscriptBox["J", "2"]]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
      "Vectors", " ", "defined", " ", "from", " ", "projection", " ", 
       "tensors", " ", "x"}], " ", "=", " ", 
      RowBox[{
       SuperscriptBox["u", "\[Alpha]"], 
       SubscriptBox["\[Phi]", "\[Alpha]"]}]}], ",", " ", 
     RowBox[{"y", " ", "=", " ", 
      RowBox[{
       SuperscriptBox["b", "\[Alpha]"], 
       SubscriptBox["\[Phi]", "\[Alpha]"]}]}], ",", " ", 
     RowBox[{
      SuperscriptBox["z", "2"], " ", "=", " ", 
      RowBox[{
       SubscriptBox["\[Phi]", "\[Alpha]"], 
       SubscriptBox["\[Phi]", "\[Beta]"], 
       SuperscriptBox[
        SubscriptBox["\[CapitalDelta]", "\[ScriptCapitalJ]"], 
        "\[Alpha]\[Beta]"]}]}], ",", " ", 
     RowBox[{
      SuperscriptBox["v", "2"], " ", "=", " ", 
      RowBox[{
       SubscriptBox["\[Phi]", "\[Alpha]"], 
       SubscriptBox["\[Phi]", "\[Beta]"], 
       SuperscriptBox["\[CapitalDelta]", "\[Alpha]\[Beta]"]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"z", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{
       SuperscriptBox["v", "2"], "-", 
       FractionBox[
        SuperscriptBox["y", "2"], 
        SuperscriptBox["J", "2"]]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Z", "=", 
     RowBox[{"{", 
      RowBox[{"0", ",", "z", ",", "0", ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Phi]", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "x"}], "*", "U"}], "+", 
      FractionBox[
       RowBox[{"y", "*", "\[ScriptCapitalJ]"}], 
       SuperscriptBox["J", "2"]], "+", "Z"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"V", "=", 
     RowBox[{"ginv", ".", 
      RowBox[{"(", 
       RowBox[{"\[CapitalDelta]", ".", "\[Phi]"}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Function", " ", "for", " ", "removing", " ", "rows", " ", "and", " ", 
     "columns", " ", "from", " ", "matrices"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"RemoveEoMs", "[", 
     RowBox[{
      RowBox[{"matrix_", "?", "MatrixQ"}], ",", "row_List", ",", 
      "column_List"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"newrows", ",", "newcols", ",", 
        RowBox[{"length", "=", 
         RowBox[{"Length", "[", "matrix", "]"}]}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"newrows", "=", 
        RowBox[{"Complement", "[", 
         RowBox[{
          RowBox[{"Range", "[", "length", "]"}], ",", "row"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"newcols", "=", 
        RowBox[{"Complement", "[", 
         RowBox[{
          RowBox[{"Range", "[", "length", "]"}], ",", "column"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"matrix", "[", 
        RowBox[{"[", 
         RowBox[{"newrows", ",", "newcols"}], "]"}], "]"}]}]}], 
     "\[IndentingNewLine]", "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.894544900607706*^9, 3.8945449113765383`*^9}, {
   3.8945450619036903`*^9, 3.894545071675393*^9}, {3.8945451290531864`*^9, 
   3.8945451873102083`*^9}, {3.894545264656769*^9, 3.8945454054012794`*^9}, {
   3.894545475355898*^9, 3.8945456518714237`*^9}, {3.894545769360799*^9, 
