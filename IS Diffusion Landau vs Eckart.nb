Cell[CellGroupData[{

Cell["Israel - Stewart with Diffusion", "Title",
 CellChangeTimes->{{3.894641104436804*^9, 
  3.894641117961378*^9}},ExpressionUUID->"ecc7246b-5e50-44ca-9078-\
