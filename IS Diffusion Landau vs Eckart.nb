          SuperscriptBox["qbar", "2"]}]}], ")"}], " ", "\[Lambda]0"}]}], 
     ")"}]}], 
   RowBox[{"6", "+", 
    RowBox[{"15", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "2"}], "+", 
       RowBox[{"3", " ", 
        SuperscriptBox["qbar", "2"]}]}], ")"}], " ", 
     "\[Lambda]0"}]}]]}]], "Output",
