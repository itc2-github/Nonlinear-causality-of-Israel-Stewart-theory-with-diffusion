Cell["Here are the linear causality conditions:", "Text",
 CellChangeTimes->{{3.9506261630081196`*^9, 
  3.950626171193968*^9}},ExpressionUUID->"64c38958-5d79-a046-a15f-\
8781f165945b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f2", "[", "y_", "]"}], ":=", 
   RowBox[{
    SuperscriptBox["y", "2"], "+", 
    RowBox[{"A1", " ", "y"}], "+", "A0"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Collect", "[", 
  RowBox[{
   RowBox[{"f2", "[", 
    RowBox[{"1", "-", "z0"}], "]"}], ",", "z0", ",", "FullSimplify"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LLinCoeff", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"CoefficientList", "[", 
     RowBox[{
      RowBox[{"Cancel", "[", 
       RowBox[{
        FractionBox["LLinTotalDet", 
         RowBox[{
          SuperscriptBox["\[CapitalOmega]", "4"], " ", 
          SuperscriptBox["x", "6"]}]], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"v", "->", "1"}], ",", 
          RowBox[{"x", "->", 
           RowBox[{"Sqrt", "[", "y", "]"}]}], ",", 
          RowBox[{"P\[CurlyEpsilon]", "->", 
           RowBox[{
            SuperscriptBox["cs", "2"], "-", 
            FractionBox[
             RowBox[{"Pn", "*", "n"}], 
             RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}], ",", 
          RowBox[{"\[CapitalOmega]\[CurlyEpsilon]", "->", 
           RowBox[{"\[CapitalOmega]s", "-", 
            FractionBox[
             RowBox[{"\[CapitalOmega]n", "*", "n"}], 
             RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}], ",", 
          RowBox[{"\[CapitalTheta]\[CurlyEpsilon]", "->", 
           RowBox[{"\[CapitalTheta]s", "-", 
            FractionBox[
             RowBox[{"\[CapitalTheta]n", "*", "n"}], 
             RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}]}], "}"}]}], "]"}], ",",
       "y"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]LLin", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"Discriminant", "[", 
     RowBox[{
      RowBox[{"Cancel", "[", 
       RowBox[{
        FractionBox["LLinTotalDet", 
         RowBox[{
          SuperscriptBox["\[CapitalOmega]", "4"], " ", 
          SuperscriptBox["x", "6"]}]], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"v", "->", "1"}], ",", 
          RowBox[{"x", "->", 
           RowBox[{"Sqrt", "[", "y", "]"}]}], ",", 
          RowBox[{"P\[CurlyEpsilon]", "->", 
           RowBox[{
            SuperscriptBox["cs", "2"], "-", 
            FractionBox[
             RowBox[{"Pn", "*", "n"}], 
             RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}], ",", 
          RowBox[{"\[CapitalOmega]\[CurlyEpsilon]", "->", 
           RowBox[{"\[CapitalOmega]s", "-", 
            FractionBox[
             RowBox[{"\[CapitalOmega]n", "*", "n"}], 
             RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}], ",", 
          RowBox[{"\[CapitalTheta]\[CurlyEpsilon]", "->", 
           RowBox[{"\[CapitalTheta]s", "-", 
            FractionBox[
             RowBox[{"\[CapitalTheta]n", "*", "n"}], 
             RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}]}], "}"}]}], "]"}], ",",
       "y"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LLinA1", "=", 
   RowBox[{"LLinCoeff", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LLinA0", "=", 
   RowBox[{"LLinCoeff", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "\"\<The linearized causality conditions are :\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<0 \[LessEqual] -\!\(\*SubscriptBox[\(A\), \(1\)]\)/2 \
\[LessEqual] 1: 0 \[LessEqual] \>\"", ",", 
   RowBox[{"-", 
    FractionBox["LLinA1", "2"]}], ",", "\"\< \[LessEqual] 1\>\""}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<0 \[LessEqual] \!\(\*SubscriptBox[\(A\), \(0\)]\): 0 \
\[LessEqual] \>\"", ",", "LLinA0"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<0 \[LessEqual] 1 + \!\(\*SubscriptBox[\(A\), \(0\)]\) + \
\!\(\*SubscriptBox[\(A\), \(1\)]\): 0 \[LessEqual] \>\"", ",", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"1", "+", "LLinA0", "+", "LLinA1"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<0 \[LessEqual] \!\(\*SubscriptBox[\(\[CapitalDelta]\), \
\(2\)]\) : 0 \[LessEqual] \>\"", ",", "\[CapitalDelta]LLin"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", 
  "[", "\"\<For the ultrarelativistic equation of state, they are :\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[CapitalDelta]LLin", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"\[CapitalDelta]LLin", "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cs", "->", 
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", "3", "]"}]}]}], ",", 
       RowBox[{"P", "->", 
        RowBox[{"\[CurlyEpsilon]", "/", "3"}]}], ",", 
       RowBox[{"Pn", "->", "0"}], ",", 
       RowBox[{"\[CapitalTheta]n", "->", 
        RowBox[{"(*", 
         FractionBox["Pn", 
          RowBox[{"n", " ", "T"}]], "*)"}], 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"4", 
            RowBox[{"\[CurlyEpsilon]", "/", "3"}]}], 
           RowBox[{"n", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              FractionBox[
               RowBox[{"\[CurlyEpsilon]", "/", "3"}], "n"], ")"}], "2"]}]]}], 
         RowBox[{"(", 
          FractionBox[
           RowBox[{
            RowBox[{"-", "\[CurlyEpsilon]"}], "/", "3"}], 
           SuperscriptBox["n", "2"]], ")"}]}]}], ",", 
       RowBox[{"Tn", "->", 
        FractionBox[
         RowBox[{
          RowBox[{"-", "\[CurlyEpsilon]"}], "/", "3"}], 
         SuperscriptBox["n", "2"]]}], ",", 
       RowBox[{"T", "->", 
        FractionBox[
         RowBox[{"\[CurlyEpsilon]", "/", "3"}], "n"]}], ",", 
       RowBox[{"\[CapitalOmega]s", "->", 
        RowBox[{
         FractionBox["n", 
          RowBox[{"4", 
           RowBox[{"\[CurlyEpsilon]", "/", "3"}]}]], 
         RowBox[{"(", " ", 
          RowBox[{"-", 
           FractionBox[
            RowBox[{"20", " ", "\[Lambda]"}], 
            SuperscriptBox["n", "2"]]}], ")"}]}]}], ",", 
       RowBox[{"\[CapitalOmega]", "->", " ", 
        FractionBox[
         RowBox[{"20", " ", "\[Lambda]"}], "n"]}], ",", 
       RowBox[{"\[CapitalOmega]n", "->", " ", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{"20", " ", "\[Lambda]"}], 
          SuperscriptBox["n", "2"]]}]}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LLinCoeff", "=", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"LLinCoeff", "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"cs", "->", 
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", "3", "]"}]}]}], ",", 
       RowBox[{"P", "->", 
        RowBox[{"\[CurlyEpsilon]", "/", "3"}]}], ",", 
       RowBox[{"Pn", "->", "0"}], ",", 
       RowBox[{"\[CapitalTheta]n", "->", 
        RowBox[{"(*", 
         FractionBox["Pn", 
          RowBox[{"n", " ", "T"}]], "*)"}], 
        RowBox[{
         RowBox[{"-", 
          FractionBox[
           RowBox[{"4", 
            RowBox[{"\[CurlyEpsilon]", "/", "3"}]}], 
           RowBox[{"n", " ", 
            SuperscriptBox[
             RowBox[{"(", 
              FractionBox[
               RowBox[{"\[CurlyEpsilon]", "/", "3"}], "n"], ")"}], "2"]}]]}], 
         RowBox[{"(", 
