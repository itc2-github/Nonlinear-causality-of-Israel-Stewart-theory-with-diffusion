Cell["\<\
Next we upload the coefficients into a list and generate the inequalities:\
\>", "Text",
 CellChangeTimes->{{3.936378330525427*^9, 
  3.936378344514677*^9}},ExpressionUUID->"b54e2cd4-a091-b947-8367-\
4e50ea1e3ae7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"LCoeff", "=", 
   RowBox[{"CoefficientList", "[", 
    RowBox[{
     RowBox[{"Cancel", "[", 
      RowBox[{
       FractionBox["LTotalDet", 
        RowBox[{
         SuperscriptBox["\[CapitalOmega]", "4"], " ", 
         SuperscriptBox["x", "6"]}]], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"v", "->", "1"}], ",", 
         RowBox[{"y", "->", 
          RowBox[{"\[Psi]", " ", "J"}]}], ",", 
         RowBox[{"P\[CurlyEpsilon]", "->", 
          RowBox[{
           SuperscriptBox["cs", "2"], "-", 
           FractionBox[
            RowBox[{"Pn", "*", "n"}], 
            RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}], ",", 
         RowBox[{"\[CapitalOmega]\[CurlyEpsilon]", "->", 
          RowBox[{"\[CapitalOmega]sn", "-", 
           FractionBox[
            RowBox[{"\[CapitalOmega]n", "*", "n"}], 
            RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}], ",", 
         RowBox[{"\[CapitalTheta]\[CurlyEpsilon]", "->", 
          RowBox[{"\[CapitalTheta]sn", "-", 
           FractionBox[
            RowBox[{"\[CapitalTheta]n", "*", "n"}], 
            RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}]}], "}"}]}], "]"}], ",",
      "x"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LB", "=", 
   RowBox[{"LCoeff", "[", 
    RowBox[{"[", "4", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LC", "=", 
   RowBox[{"LCoeff", "[", 
    RowBox[{"[", "3", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LD", "=", 
   RowBox[{"LCoeff", "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LE", "=", 
   RowBox[{"LCoeff", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<|B|/4 \[LessEqual] 1: \>\"", ",", 
   RowBox[{"Abs", "[", 
    RowBox[{"FullSimplify", "[", 
     FractionBox["LB", "4"], "]"}], "]"}], ",", "\"\< \[LessEqual] 1\>\""}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<|B| \[LessEqual] 2 + \!\(\*FractionBox[\(C\), \(3\)]\): \>\"", 
   ",", 
   RowBox[{"Abs", "[", 
    RowBox[{"FullSimplify", "[", "LB", "]"}], "]"}], 
   ",", "\"\< \[LessEqual] \>\"", ",", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"2", "+", 
     FractionBox["LC", "3"]}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<|3B + D| \[LessEqual] 4 + 2C: \>\"", ",", 
   RowBox[{"Abs", "[", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{
      RowBox[{"3", "LB"}], "+", "LD"}], "]"}], "]"}], 
   ",", "\"\< \[LessEqual] \>\"", ",", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"4", "+", 
     RowBox[{"2", "LC"}]}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<|B + D| \[LessEqual] 1 + E + C: \>\"", ",", 
   RowBox[{"Abs", "[", 
    RowBox[{"FullSimplify", "[", 
     RowBox[{"LB", "+", "LD"}], "]"}], "]"}], ",", "\"\< \[LessEqual] \>\"", ",", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{"1", "+", "LE", "+", "LC"}], "]"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Print", "[", 
    RowBox[{"\"\<The discriminant is \[CapitalDelta] = \>\"", ",", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{"Discriminant", "[", 
       RowBox[{
        RowBox[{"Cancel", "[", 
         RowBox[{
          FractionBox["LTotalDet", 
           RowBox[{
            SuperscriptBox["\[CapitalOmega]", "4"], " ", 
            SuperscriptBox["x", "6"]}]], "/.", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"v", "->", "1"}], ",", 
            RowBox[{"y", "->", 
             RowBox[{"\[Kappa]", " ", "J"}]}], ",", 
            RowBox[{"P\[CurlyEpsilon]", "->", 
             RowBox[{
              SuperscriptBox["cs", "2"], "-", 
              FractionBox[
               RowBox[{"Pn", "*", "n"}], 
               RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}], ",", 
            RowBox[{"\[CapitalOmega]\[CurlyEpsilon]", "->", 
             RowBox[{"\[CapitalOmega]sn", "-", 
              FractionBox[
               RowBox[{"\[CapitalOmega]n", "*", "n"}], 
               RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}], ",", 
            RowBox[{"\[CapitalTheta]\[CurlyEpsilon]", "->", 
             RowBox[{"\[CapitalTheta]sn", "-", 
              FractionBox[
               RowBox[{"\[CapitalTheta]n", "*", "n"}], 
               RowBox[{"P", "+", "\[CurlyEpsilon]"}]]}]}]}], "}"}]}], "]"}], ",",
         "x"}], "]"}], "]"}]}], "]"}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.9363782904419117`*^9, 3.936378369649908*^9}, {
